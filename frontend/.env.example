# Settings the frontend reads. Copy to .env.local (not committed) to change them for development, or set them in the
# environment of `npm run build` for a release: Vite puts the VITE_ values into the built files, so they are not secrets.

# Where the API is. The default is the same origin ("/api/v1"), which is what the dev server (it proxies /api) and a
# production web server that forwards /api to the backend both give. Set a full URL only if the API is on another origin
# (then it must allow this origin in CORS, and the Content-Security-Policy connect-src must list it).
# VITE_API_BASE=/api/v1

# Dev server only: where /api is proxied to.
# VITE_API_PROXY=http://127.0.0.1:8000

# The newest release whose screens are switched on: R1a | R1b | R1c | R2. Screens of a later release show as disabled.
# VITE_RELEASE=R1a

# Emergency only: use a reply that does not match its schema (it is logged and not refused). Leave unset.
# VITE_LENIENT_CONTRACT=1
