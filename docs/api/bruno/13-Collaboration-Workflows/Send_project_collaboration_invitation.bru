meta {
  name: Send project collaboration invitation
  type: http
  seq: 1
}

post {
  url: {{base_url}}/projects/1/invitations
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
{
    "email": "colleague@hadith.ac.krd",
    "role": "co_investigator",
    "expires_days": 7
}
}
